+use std::fs::OpenOptions;
+use std::io::Read;
+use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+use std::path::Path;
+
+pub fn load(path: &Path) -> Result<String, &'static str> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(path)
+        .map_err(|_| "Cannot open credential file")?;
+    let meta = file
+        .metadata()
+        .map_err(|_| "Cannot inspect credential file")?;
+    if !meta.is_file()
+        || meta.nlink() != 1
+        || meta.mode() & 0o7777 != 0o600
+        || meta.uid() != unsafe { libc::geteuid() }
+        || meta.len() > 4096
+    {
+        return Err("Unsafe credential file");
+    }
+    let mut password = String::new();
+    file.take(4097)
+        .read_to_string(&mut password)
+        .map_err(|_| "Cannot read credential file")?;
+    if password.is_empty() || password.len() > 4096 || password.contains(['\0', '\r', '\n']) {
+        return Err("Invalid credential file");
+    }
+    Ok(password)
+}
+
+#[cfg(test)]
+mod tests {
+    use std::fs;
+    use std::os::unix::fs::{PermissionsExt, symlink};
+
+    use super::*;
+    #[test]
+    fn private_file_is_exact_and_errors_never_echo_content() {
+        let root = std::env::temp_dir().join(format!("relay-credential-{}", uuid::Uuid::new_v4()));
+        fs::create_dir(&root).unwrap();
+        let path = root.join("credential");
+        fs::write(&path, "synthetic-password").unwrap();
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o600)).unwrap();
+        assert_eq!(load(&path).unwrap(), "synthetic-password");
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o644)).unwrap();
+        assert_eq!(load(&path).unwrap_err(), "Unsafe credential file");
+        let link = root.join("link");
+        symlink(&path, &link).unwrap();
+        assert!(load(&link).is_err());
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o600)).unwrap();
+        fs::write(&path, "secret\n").unwrap();
+        assert_eq!(load(&path).unwrap_err(), "Invalid credential file");
+        fs::remove_dir_all(root).unwrap();
+    }
+}
