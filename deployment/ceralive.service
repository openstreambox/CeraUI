[Unit]
Description=CeraLive service
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
# Shared runtime files must exist before the backend publishes a ruleset.
RuntimeDirectory=ceralive
RuntimeDirectoryMode=0700
# Other services use this directory; preserve it until the next boot.
RuntimeDirectoryPreserve=yes
Environment=NODE_ENV=production
WorkingDirectory=/opt/ceralive/
ExecStart=/usr/local/bin/ceralive
KillMode=mixed
Restart=always
RestartSec=2s
# A kill takes srtla_send with it (KillMode=mixed) and ends a live stream.
# Leave room for bounded main-loop stalls such as a 30 s Bun.spawnSync
# timeout; the backend pulses every second.
WatchdogSec=90s
# A stopped or wedged owner must close its inhibitor descriptor immediately.
WatchdogSignal=SIGKILL
SyslogIdentifier=ceralive

[Install]
WantedBy=multi-user.target
