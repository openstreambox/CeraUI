[Unit]
Description=CeraLive service
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
# Shared runtime files must exist before the backend publishes a ruleset.
RuntimeDirectory=ceralive
RuntimeDirectoryMode=0700
# Other services use this directory; preserve it until the next boot.
RuntimeDirectoryPreserve=yes
Environment=NODE_ENV=production
WorkingDirectory=/opt/ceralive/
ExecStart=/usr/local/bin/ceralive
KillMode=mixed
Restart=always
RestartSec=2s
WatchdogSec=30s
# A stopped or wedged owner must close its inhibitor descriptor immediately.
WatchdogSignal=SIGKILL
SyslogIdentifier=ceralive

[Install]
WantedBy=multi-user.target
